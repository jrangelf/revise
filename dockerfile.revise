FROM ubuntu:noble

WORKDIR /revise

COPY requirements.txt .

#RUN apt update -y && \
#    apt install -y cron 
        
#RUN apt-get install -y build-essential python3
#RUN apt-get install -y python3-dev
#RUN apt-get install -y python3-pip

##RUN pip3 install --no-cache-dir -r requirements.txt
##RUN pip3 install --break-system-packages --no-cache-dir -r requirements.txt

#RUN pip3 install --break-system-packages --no-cache-dir \
#    -r requirements.txt

# Instalar dependências do sistema operacional
RUN apt update && \
    apt install -y --no-install-recommends \
        cron \
        build-essential \
        python3 \
        python3-dev \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Copiar as dependências Python
COPY requirements.txt .

# Instalar bibliotecas Python
RUN pip3 install --break-system-packages --no-cache-dir \
    -r requirements.txt

# Configurar o fuso horário de Brasília
ENV TZ=America/Sao_Paulo

RUN ln -snf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime && \
    echo "America/Sao_Paulo" > /etc/timezone
    
ENV PYTHONIOENCODING=utf-8
ENV LANG=en_US.UTF-8

COPY cron_job /etc/cron.d/cron_job
RUN chmod 0644 /etc/cron.d/cron_job

#RUN crontab /etc/cron.d/cron_job

COPY run_verificar_data.sh /revise/run_verificar_data.sh
RUN chmod +x /revise/run_verificar_data.sh

CMD ["cron", "-f"]
